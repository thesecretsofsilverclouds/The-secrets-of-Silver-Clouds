{
  "name": "silver-clouds-worldstream",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "worldstream": "node start-worldstream.mjs",
    "preview:cinematic": "node scripts/preview-cinematic.mjs",
